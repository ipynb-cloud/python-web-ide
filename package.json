{
  "name": "cm6-python-bundle",
  "version": "1.0.0",
  "description": "Bundles CodeMirror 6 with Python support for PyNote",
  "scripts": {
    "build:cm6": "esbuild cm6-entry.js --bundle --minify --format=iife --outfile=cm6.bundle.min.js",
    "build:notebook": "esbuild notebook-generic.js --bundle --minify --format=iife --outfile=pynote-bundle.min.js",
    "build": "npm run build:cm6 && npm run build:notebook"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.33.0",
    "@tailwindcss/cli": "^4.3.3",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "tailwindcss": "^4.3.3"
  },
  "main": "python-web-ide.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipynb-cloud/python-web-ide.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ipynb-cloud/python-web-ide/issues"
  },
  "homepage": "https://github.com/ipynb-cloud/python-web-ide#readme"
}
